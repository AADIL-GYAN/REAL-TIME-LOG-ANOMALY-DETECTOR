# --- Monitoring ---
LOG_FILE=logs/app.log        # any growing log file
SIMULATE=1                   # 0 = monitor a real log, no fake traffic
WINDOW_SECONDS=30
BASELINE_SECONDS=60
ZSCORE_THRESHOLD=3.0

# --- Optional AWS (leave blank to run locally) ---
AWS_REGION=
CLOUDWATCH_LOG_GROUP=/anomaly-detector/alerts
CLOUDWATCH_LOG_STREAM=alerts
SNS_TOPIC_ARN=
